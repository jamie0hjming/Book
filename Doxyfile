# Doxyfile for Sensor Data Acquisition Library
# Generates HTML + CHM documentation.
# Usage:  cd c_project && doxygen Doxyfile   (or run gen_docs.sh)

# ---------------------------------------------------------------------------
# Project info
# ---------------------------------------------------------------------------
PROJECT_NAME           = "Sensor Data Acquisition Library"
PROJECT_NUMBER         = 1.0.0
PROJECT_BRIEF          = "Embedded sensor driver & signal-processing library"
OUTPUT_DIRECTORY       = docs
CREATE_SUBDIRS         = NO

# ---------------------------------------------------------------------------
# Input
# ---------------------------------------------------------------------------
INPUT                  = include src main_page.md
FILE_PATTERNS          = *.c *.h *.md
RECURSIVE              = YES

# ---------------------------------------------------------------------------
# Parse all documented entities
# ---------------------------------------------------------------------------
EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
EXTRACT_STATIC         = NO
EXTRACT_LOCAL_CLASSES  = NO

# ---------------------------------------------------------------------------
# HTML output
# ---------------------------------------------------------------------------
GENERATE_HTML          = YES
HTML_OUTPUT            = html
HTML_COLORSTYLE_HUE    = 220
HTML_COLORSTYLE_SAT    = 100
HTML_COLORSTYLE_GAMMA  = 80
HTML_DYNAMIC_SECTIONS  = NO

# ---------------------------------------------------------------------------
# CHM output
# ---------------------------------------------------------------------------
GENERATE_HTMLHELP      = YES
CHM_FILE               = ../sensor_library.chm
HHC_LOCATION           = "C:\Program Files (x86)\HTML Help Workshop\hhc.exe"
GENERATE_CHI           = NO
BINARY_TOC             = NO
TOC_EXPAND             = YES
DISABLE_INDEX          = NO
GENERATE_TREEVIEW      = NO
SEARCHENGINE           = NO
HTML_DYNAMIC_MENUS     = NO

# ---------------------------------------------------------------------------
# LaTeX output (disabled)
# ---------------------------------------------------------------------------
GENERATE_LATEX         = NO

# ---------------------------------------------------------------------------
# Preprocessing
# ---------------------------------------------------------------------------
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = NO

# ---------------------------------------------------------------------------
# Dot / Diagrams
# ---------------------------------------------------------------------------
HAVE_DOT               = NO
CLASS_GRAPH            = NO
CALL_GRAPH             = NO
CALLER_GRAPH           = NO

# ---------------------------------------------------------------------------
# Source browsing
# ---------------------------------------------------------------------------
SOURCE_BROWSER         = YES
INLINE_SOURCES         = NO
REFERENCED_BY_RELATION = YES
REFERENCES_RELATION    = YES

# ---------------------------------------------------------------------------
# Warning / Error handling
# ---------------------------------------------------------------------------
QUIET                  = NO
WARNINGS               = YES
WARN_IF_UNDOCUMENTED   = YES
WARN_IF_DOC_ERROR      = YES
WARN_NO_PARAMDOC       = YES
WARN_FORMAT            = "$file:$line: $text"
